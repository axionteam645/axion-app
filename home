  <script>
    const CONFIG = {
      AX_TOKEN: '0x0B9378b8618CF6617818C307a9facDEFa978967d',
      FEE_WALLET: '0xd543A36c00C478D211f9eB99b45B839474cea384',
      PRESALE_RECEIVER: '0x570ecca843baa357502c1e24c508576cff49f47c',
      BSC_CHAIN_ID: '0x38',
      TOTAL_ALLOCATION_AX: 5000000,
      RATE_AX_PER_BNB: 10000,
      AX_DECIMALS: 18,
      USDT: '0x55d398326f99059fF775485246999027B3197955',
      DEXSCREENER_PAIR_URL: 'https://api.dexscreener.com/latest/dex/tokens/0x0B9378b8618CF6617818C307a9facDEFa978967d'
    };

    const ERC20_ABI = [
      'function balanceOf(address owner) view returns (uint256)',
      'function decimals() view returns (uint8)',
      'function symbol() view returns (string)'
    ];

    let provider;
    let signer;
    let userAddress = null;
    let connectedWalletCount = 0;

    const els = {
      walletBtn: document.getElementById('walletBtn'),
      connectReceiveBtn: document.getElementById('connectReceiveBtn'),
      copyReceiveAddressBtn: document.getElementById('copyReceiveAddressBtn'),
      copyContractBtn: document.getElementById('copyContractBtn'),
      copyReceiverBtn: document.getElementById('copyReceiverBtn'),
      buyNowBtn: document.getElementById('buyNowBtn'),
      walletAddressShort: document.getElementById('walletAddressShort'),
      receiveWalletText: document.getElementById('receiveWalletText'),
      walletCountLive: document.getElementById('walletCountLive'),
      axBalance: document.getElementById('axBalance'),
      bnbBalance: document.getElementById('bnbBalance'),
      usdtBalance: document.getElementById('usdtBalance'),
      axPrice: document.getElementById('axPrice'),
      axPriceChange: document.getElementById('axPriceChange'),
      feeWalletBalance: document.getElementById('feeWalletBalance'),
      marketBarPrice: document.getElementById('marketBarPrice'),
      marketBarChange: document.getElementById('marketBarChange'),
      marketBarLiquidity: document.getElementById('marketBarLiquidity'),
      marketBarVolume: document.getElementById('marketBarVolume'),
      bnbAmount: document.getElementById('bnbAmount'),
      axReceivePreview: document.getElementById('axReceivePreview'),
      presaleSuccess: document.getElementById('presaleSuccess'),
      progressFill: document.getElementById('progressFill'),
      allocationProgressText: document.getElementById('allocationProgressText'),
      mobileToggle: document.getElementById('mobileToggle'),
      navLinks: document.getElementById('navLinks')
    };

    function shortAddress(address){
      return address ? `${address.slice(0,6)}...${address.slice(-4)}` : 'Not connected';
    }

    function formatNumber(value, digits = 2){
      if (!isFinite(value)) return '-';
      return new Intl.NumberFormat('en-US', { maximumFractionDigits: digits }).format(value);
    }

    function formatCurrency(value){
      if (!isFinite(value)) return '—';
      return new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: value < 1 ? 6 : 2 }).format(value);
    }

    async function copyText(text){
      try{
        await navigator.clipboard.writeText(text);
      }catch(err){
        console.warn('Copy failed', err);
      }
    }

    async function connectWallet(){
      if (!window.ethereum) {
        alert('No wallet provider detected. Open this page in MetaMask, Trust Wallet, or another Web3 browser.');
        return;
      }
      try {
        provider = new ethers.providers.Web3Provider(window.ethereum, 'any');
        await provider.send('eth_requestAccounts', []);
        const network = await provider.getNetwork();
        if (network.chainId !== 56) {
          try {
            await window.ethereum.request({ method:'wallet_switchEthereumChain', params:[{ chainId: CONFIG.BSC_CHAIN_ID }] });
          } catch (switchErr) {
            console.warn('Chain switch failed', switchErr);
          }
        }
        signer = provider.getSigner();
        userAddress = await signer.getAddress();
        connectedWalletCount += 1;
        els.walletCountLive.textContent = connectedWalletCount;
        els.walletAddressShort.textContent = shortAddress(userAddress);
        els.receiveWalletText.textContent = userAddress;
        els.walletBtn.textContent = 'Disconnect';
        await refreshWalletBalances();
      } catch (err) {
        console.error('Wallet connect error', err);
      }
    }

    function disconnectWallet(){
      provider = null;
      signer = null;
      userAddress = null;
      els.walletAddressShort.textContent = 'Not connected';
      els.receiveWalletText.textContent = 'Connect wallet to view your receive address.';
      els.walletBtn.textContent = 'Connect Wallet';
      els.axBalance.textContent = '-';
      els.bnbBalance.textContent = '-';
      els.usdtBalance.textContent = '-';
    }

    async function refreshWalletBalances(){
      if (!provider || !userAddress) return;
      try {
        const axContract = new ethers.Contract(CONFIG.AX_TOKEN, ERC20_ABI, provider);
        const usdtContract = new ethers.Contract(CONFIG.USDT, ERC20_ABI, provider);

        const [axBalRaw, bnbBalRaw, usdtBalRaw] = await Promise.all([
          axContract.balanceOf(userAddress),
          provider.getBalance(userAddress),
          usdtContract.balanceOf(userAddress)
        ]);

        els.axBalance.textContent = `${formatNumber(Number(ethers.utils.formatUnits(axBalRaw, CONFIG.AX_DECIMALS)), 2)} AX`;
        els.bnbBalance.textContent = `${formatNumber(Number(ethers.utils.formatEther(bnbBalRaw)), 4)} BNB`;
        els.usdtBalance.textContent = `${formatNumber(Number(ethers.utils.formatUnits(usdtBalRaw, 18)), 2)} USDT`;
      } catch (err) {
        console.warn('Wallet balance fetch failed', err);
      }
    }

    async function fetchFeeWalletBalance(){
      try {
        const rpc = new ethers.providers.JsonRpcProvider('https://bsc-dataseed.binance.org/');
        const axContract = new ethers.Contract(CONFIG.AX_TOKEN, ERC20_ABI, rpc);
        const feeRaw = await axContract.balanceOf(CONFIG.FEE_WALLET);
        const feeValue = Number(ethers.utils.formatUnits(feeRaw, CONFIG.AX_DECIMALS));
        els.feeWalletBalance.textContent = `${formatNumber(feeValue, 2)} AX`;
      } catch (err) {
        els.feeWalletBalance.textContent = 'Unable to load fee wallet';
      }
    }

    async function fetchPresaleProgress(){
      try {
        const rpc = new ethers.providers.JsonRpcProvider('https://bsc-dataseed.binance.org/');
        const axContract = new ethers.Contract(CONFIG.AX_TOKEN, ERC20_ABI, rpc);
        const receiverBalanceRaw = await axContract.balanceOf(CONFIG.PRESALE_RECEIVER);
        const receiverBalance = Number(ethers.utils.formatUnits(receiverBalanceRaw, CONFIG.AX_DECIMALS));
        const sold = Math.max(0, CONFIG.TOTAL_ALLOCATION_AX - receiverBalance);
        const progress = Math.min(100, (sold / CONFIG.TOTAL_ALLOCATION_AX) * 100);
        els.progressFill.style.width = `${progress.toFixed(2)}%`;
        els.allocationProgressText.textContent = `${formatNumber(sold, 2)} AX sold · ${progress.toFixed(2)}%`;
      } catch (err) {
        els.allocationProgressText.textContent = 'Live sold amount unavailable';
      }
    }

    async function fetchDexData(){
      try {
        const res = await fetch(CONFIG.DEXSCREENER_PAIR_URL);
        const data = await res.json();
        const pairs = Array.isArray(data?.pairs) ? data.pairs : [];
        const pair = pairs.find(p => String(p.chainId).toLowerCase() === 'bsc') || pairs[0];
        if (!pair) throw new Error('No pair found');
        const price = Number(pair.priceUsd || 0);
        const change = Number(pair.priceChange?.h24 || 0);
        const liquidity = Number(pair.liquidity?.usd || 0);
        const volume = Number(pair.volume?.h24 || 0);

        const changeClass = change > 0 ? 'up' : change < 0 ? 'down' : 'neutral';
        const changeText = `${change > 0 ? '▲' : change < 0 ? '▼' : '•'} ${formatNumber(change, 2)}%`;

        els.axPrice.textContent = formatCurrency(price);
        els.marketBarPrice.textContent = formatCurrency(price);
        els.axPriceChange.textContent = changeText;
        els.marketBarChange.textContent = changeText;
        els.axPriceChange.className = `price-change ${changeClass}`;
        els.marketBarChange.className = `price-change ${changeClass}`;
        els.marketBarLiquidity.textContent = formatCurrency(liquidity);
        els.marketBarVolume.textContent = formatCurrency(volume);
      } catch (err) {
        els.axPrice.textContent = 'Live price unavailable';
        els.axPriceChange.textContent = 'Data unavailable';
        els.marketBarPrice.textContent = 'Unavailable';
        els.marketBarChange.textContent = 'Unavailable';
        els.marketBarLiquidity.textContent = 'Unavailable';
        els.marketBarVolume.textContent = 'Unavailable';
      }
    }

    function updateReceivePreview(){
      const bnb = Number(els.bnbAmount.value || 0);
      const ax = bnb * CONFIG.RATE_AX_PER_BNB;
      els.axReceivePreview.textContent = `${formatNumber(ax, 2)} AX`;
    }

    function initChart(){
      const canvas = document.getElementById('tokenChart');
      if (!canvas || typeof Chart === 'undefined') return;
      new Chart(canvas, {
        type: 'doughnut',
        data: {
          labels: ['Fund', 'Liquidity', 'Marketing', 'CEX Listings', 'Team'],
          datasets: [{
            data: [25, 25, 20, 20, 10],
            backgroundColor: ['#4ed8ff', '#5f8cff', '#a85cff', '#ff5cb8', '#ffc95c'],
            borderColor: 'rgba(4,8,20,0.9)',
            borderWidth: 4,
            hoverOffset: 6
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: true,
          cutout: '62%',
          plugins: {
            legend: { display: false },
            tooltip: {
              backgroundColor: 'rgba(7,12,28,0.96)',
              borderColor: 'rgba(255,255,255,0.1)',
              borderWidth: 1,
              titleColor: '#fff',
              bodyColor: '#dce7ff'
            }
          }
        }
      });
    }

    function initReveal(){
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) entry.target.classList.add('show');
        });
      }, { threshold: 0.12 });
      document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
    }

    function initEvents(){
      els.walletBtn.addEventListener('click', () => userAddress ? disconnectWallet() : connectWallet());
      els.connectReceiveBtn.addEventListener('click', connectWallet);
      els.copyReceiveAddressBtn.addEventListener('click', () => copyText(userAddress || ''));
      els.copyContractBtn.addEventListener('click', () => copyText(CONFIG.AX_TOKEN));
      els.copyReceiverBtn.addEventListener('click', () => copyText(CONFIG.PRESALE_RECEIVER));
      els.buyNowBtn.addEventListener('click', () => els.presaleSuccess.classList.add('show'));
      els.bnbAmount.addEventListener('input', updateReceivePreview);
      els.mobileToggle.addEventListener('click', () => els.navLinks.classList.toggle('open'));
      document.querySelectorAll('.nav-links a').forEach(link => {
        link.addEventListener('click', () => els.navLinks.classList.remove('open'));
      });
      if (window.ethereum) {
        window.ethereum.on?.('accountsChanged', async (accounts) => {
          if (!accounts || !accounts.length) disconnectWallet();
          else {
            userAddress = accounts[0];
            els.walletAddressShort.textContent = shortAddress(userAddress);
            els.receiveWalletText.textContent = userAddress;
            await refreshWalletBalances();
          }
        });
      }
    }

    async function init(){
      initReveal();
      initChart();
      initEvents();
      updateReceivePreview();
      await Promise.all([fetchDexData(), fetchFeeWalletBalance(), fetchPresaleProgress()]);
      setInterval(fetchDexData, 30000);
      setInterval(fetchFeeWalletBalance, 45000);
      setInterval(fetchPresaleProgress, 45000);
    }

    init();
  </script>
