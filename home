<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>AXION Dashboard</title>
  <meta name="description" content="AXION dashboard with wallet connection, presale access, live balances, fee wallet tracking, and real-time ecosystem data on BNB Smart Chain." />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700;800;900&display=swap" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/ethers@5.7.2/dist/ethers.umd.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <style>
    :root{
      --bg:#040814;
      --text:#ecf3ff;
      --muted:#99a8c7;
      --cyan:#4ed8ff;
      --blue:#5f8cff;
      --purple:#a85cff;
      --pink:#ff5cb8;
      --gold:#ffc95c;
      --green:#43f3b1;
      --buy1:#ffcf5a;
      --buy2:#ff8a1f;
      --buy3:#ff4d6d;
      --shadow:0 18px 60px rgba(0,0,0,.42);
      --max:1280px;
      --success-bg:rgba(67,243,177,.09);
      --success-border:rgba(67,243,177,.28);
      --success-text:#dffff2;
    }

    *{margin:0;padding:0;box-sizing:border-box}
    html{scroll-behavior:smooth}
    body{
      font-family:'Inter',sans-serif;
      background:
        radial-gradient(circle at 20% 0%, rgba(78,216,255,.16), transparent 24%),
        radial-gradient(circle at 80% 10%, rgba(168,92,255,.15), transparent 26%),
        radial-gradient(circle at 50% 100%, rgba(255,92,184,.08), transparent 28%),
        linear-gradient(180deg,#02050e 0%, #040814 36%, #060b1a 100%);
      color:var(--text);
      overflow-x:hidden;
    }

    body::before{
      content:"";
      position:fixed;
      inset:0;
      pointer-events:none;
      background:
        radial-gradient(circle at 12% 18%, rgba(79,168,255,.18), transparent 18%),
        radial-gradient(circle at 90% 12%, rgba(255,92,184,.12), transparent 15%),
        radial-gradient(circle at 86% 88%, rgba(78,216,255,.08), transparent 20%);
      z-index:-2;
    }

    body::after{
      content:"";
      position:fixed;
      inset:0;
      pointer-events:none;
      background-image:radial-gradient(rgba(255,255,255,.65) .7px, transparent .7px);
      background-size:38px 38px;
      opacity:.08;
      z-index:-1;
    }

    a{color:inherit;text-decoration:none}
    img{max-width:100%;display:block}
    section{scroll-margin-top:100px}

    .container{width:min(calc(100% - 32px), var(--max));margin-inline:auto}
    .section{padding:92px 0 0;position:relative}
    .section:last-of-type{padding-bottom:100px}
    .gradient-title{
      background:linear-gradient(90deg,#ffffff 0%, #9bddff 26%, #c4b1ff 58%, #ffcfe6 100%);
      -webkit-background-clip:text;background-clip:text;color:transparent;
    }
    .eyebrow{
      display:inline-flex;align-items:center;gap:10px;padding:10px 14px;border:1px solid rgba(255,255,255,.08);
      border-radius:999px;font-size:12px;font-weight:800;letter-spacing:.14em;text-transform:uppercase;
      background:rgba(255,255,255,.03);color:#d8e3ff;box-shadow:inset 0 1px 0 rgba(255,255,255,.05);
    }
    .section-head{display:flex;align-items:end;justify-content:space-between;gap:24px;margin-bottom:28px;flex-wrap:wrap}
    .section-head h2{margin:14px 0 0;font-size:clamp(32px,4vw,60px);line-height:1;letter-spacing:-.04em}

    .nav-wrap{position:sticky;top:0;z-index:50;backdrop-filter:blur(18px);background:rgba(4,9,20,.66);border-bottom:1px solid rgba(255,255,255,.06)}
    .nav{width:min(calc(100% - 32px), var(--max));margin-inline:auto;display:flex;align-items:center;justify-content:space-between;gap:10px;min-height:82px}
    .brand{display:flex;align-items:center;gap:14px;min-width:0;flex-shrink:0}
    .brand-mark{
      width:46px;height:46px;border-radius:50%;overflow:hidden;display:grid;place-items:center;
      background:linear-gradient(135deg, rgba(255,255,255,.12), rgba(255,255,255,.03)),
      linear-gradient(135deg, var(--cyan), var(--blue), var(--purple), var(--pink), var(--gold));
      box-shadow:0 0 0 1px rgba(255,255,255,.08),0 0 30px rgba(112,118,255,.18);
    }
    .brand-mark img{width:100%;height:100%;object-fit:cover}
    .brand-text strong{display:block;font-size:18px;letter-spacing:.08em}
    .brand-text small{display:block;color:#d3def8;opacity:.9;letter-spacing:.12em;font-size:10px;font-weight:700;text-transform:uppercase;white-space:nowrap}
    .nav-links{display:flex;align-items:center;justify-content:center;gap:12px;flex-wrap:nowrap;min-width:0;overflow:hidden;flex:1}
    .nav-links a{font-size:11px;font-weight:700;color:#cbd8f7;transition:.2s ease;white-space:nowrap;letter-spacing:.01em}
    .nav-links a:hover{color:#fff}
    .nav-actions{display:flex;align-items:center;gap:10px;flex-shrink:0}
    .mobile-toggle{display:none;background:transparent;border:none;color:#fff;font-size:28px;cursor:pointer}

    .btn{
      appearance:none;border:none;cursor:pointer;border-radius:999px;padding:14px 22px;font-size:14px;font-weight:800;
      font-family:inherit;letter-spacing:.01em;transition:transform .18s ease, box-shadow .18s ease, opacity .18s ease, background .18s ease;
      color:#09111f;background:linear-gradient(90deg, var(--cyan), var(--blue), var(--purple), var(--pink));box-shadow:0 10px 26px rgba(124,94,255,.26)
    }
    .btn:hover{transform:translateY(-2px) scale(1.025)}
    .btn:active{transform:translateY(0) scale(0.985)}
    .btn-secondary{color:var(--text);background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.09);box-shadow:none}
    .btn-secondary:hover{background:rgba(255,255,255,.08)}
    .btn-buy{color:#fff;background:linear-gradient(90deg, var(--buy1), var(--buy2), var(--buy3));box-shadow:0 14px 34px rgba(255,104,74,.35);border:1px solid rgba(255,255,255,.12)}

    .hero{padding:84px 0 30px;position:relative;overflow:hidden}
    .hero-grid{display:grid;grid-template-columns:1.12fr .88fr;gap:28px;align-items:start}
    .hero-copy h1{margin:0 0 18px;font-size:clamp(46px, 7vw, 88px);line-height:.96;letter-spacing:-.06em}
    .hero-copy .sub{font-size:clamp(18px,2vw,24px);font-weight:800;letter-spacing:.12em;text-transform:uppercase;color:#c8d6f8;margin-bottom:18px}
    .hero-copy p{max-width:760px;margin:0;color:var(--muted);line-height:1.8;font-size:16px}
    .hero-title-row{display:flex;align-items:flex-start;gap:16px;margin-bottom:18px}
    .hero-title-row h1{margin:0}
    .hero-main-icon{width:58px;height:58px;flex-shrink:0;margin-top:8px;color:#fff}
    .hero-main-icon svg{width:100%;height:100%;stroke:url(#axGradient);stroke-width:1.85;fill:none;filter:drop-shadow(0 0 5px rgba(78,216,255,.7)) drop-shadow(0 0 10px rgba(168,92,255,.45)) drop-shadow(0 0 16px rgba(255,92,184,.25))}
    .hero-actions{display:flex;gap:10px;margin-top:26px;flex-wrap:wrap}
    .hero-actions-equal{display:grid;grid-template-columns:repeat(3, minmax(0, 1fr));gap:12px;max-width:760px;align-items:stretch}
    .hero-actions-equal .btn{width:100%;min-height:54px;display:flex;align-items:center;justify-content:center;text-align:center;white-space:nowrap}

    .hero-feature-cards{display:grid;grid-template-columns:repeat(3, minmax(0, 1fr));gap:14px;margin-top:34px;max-width:760px}
    .hero-feature-card{min-height:112px;display:flex;flex-direction:column;justify-content:center;border-radius:20px;background:linear-gradient(180deg, rgba(255,255,255,.05), rgba(255,255,255,.025));border:1px solid rgba(255,255,255,.08);box-shadow:var(--shadow);padding:18px 20px;position:relative;overflow:hidden}
    .hero-feature-card:nth-child(1){background:linear-gradient(180deg, rgba(78,216,255,.16), rgba(95,140,255,.10)),linear-gradient(180deg, rgba(255,255,255,.05), rgba(255,255,255,.025));border-color:rgba(78,216,255,.28)}
    .hero-feature-card:nth-child(2){background:linear-gradient(180deg, rgba(95,140,255,.16), rgba(168,92,255,.10)),linear-gradient(180deg, rgba(255,255,255,.05), rgba(255,255,255,.025));border-color:rgba(95,140,255,.28)}
    .hero-feature-card:nth-child(3){background:linear-gradient(180deg, rgba(168,92,255,.16), rgba(255,92,184,.10)),linear-gradient(180deg, rgba(255,255,255,.05), rgba(255,255,255,.025));border-color:rgba(168,92,255,.28)}
    .hero-feature-card-head{display:flex;align-items:center;gap:12px;margin-bottom:12px}
    .hero-feature-icon{width:42px;height:42px;border-radius:14px;display:grid;place-items:center;flex-shrink:0;background:linear-gradient(135deg, rgba(78,216,255,.12), rgba(168,92,255,.10));border:1px solid rgba(255,255,255,.08);box-shadow:inset 0 1px 0 rgba(255,255,255,.05), 0 0 18px rgba(78,216,255,.08)}
    .hero-feature-icon svg{width:22px;height:22px;display:block;stroke:url(#axGradient);stroke-width:1.9;fill:none;filter:drop-shadow(0 0 4px rgba(78,216,255,.55)) drop-shadow(0 0 8px rgba(168,92,255,.28))}
    .hero-feature-card strong{font-size:18px;line-height:1.15;color:#ffffff}
    .hero-feature-card p{margin:0;font-size:13px;line-height:1.7;color:var(--muted);max-width:96%}

    .hero-market-bar{margin-top:18px;max-width:760px;padding:14px 18px;border-radius:20px;display:grid;grid-template-columns:repeat(4, minmax(0, 1fr));gap:0;align-items:center;background:linear-gradient(180deg, rgba(255,255,255,.055), rgba(255,255,255,.025));border:1px solid rgba(255,255,255,.08);box-shadow:var(--shadow);position:relative;overflow:hidden}
    .hero-market-bar::before{content:"";position:absolute;inset:0;background:linear-gradient(140deg, rgba(78,216,255,.07), transparent 28%, transparent 68%, rgba(168,92,255,.07)),radial-gradient(circle at 100% 100%, rgba(255,92,184,.06), transparent 22%);pointer-events:none}
    .hero-market-bar > *{position:relative;z-index:1}
    .market-item{display:flex;flex-direction:column;gap:6px;min-width:0;padding:2px 12px}
    .market-label{color:#b7c7e9;font-size:11px;font-weight:800;letter-spacing:.14em;text-transform:uppercase}
    .market-item strong{color:#ffffff;font-size:16px;line-height:1.2;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
    .market-divider{width:1px;height:38px;background:linear-gradient(180deg, transparent, rgba(255,255,255,.14), transparent);justify-self:center}
    .price-change{display:inline-flex;align-items:center;justify-content:center;min-height:24px;padding:4px 9px;border-radius:999px;font-size:11px;font-weight:900;letter-spacing:.06em;line-height:1;border:1px solid rgba(255,255,255,.08);white-space:nowrap}
    .price-change.up{color:#c9ffe6;background:rgba(67,243,177,.14);border-color:rgba(67,243,177,.28)}
    .price-change.down{color:#ffd7df;background:rgba(255,92,120,.14);border-color:rgba(255,92,120,.28)}
    .price-change.neutral{color:#dffbff;background:rgba(78,216,255,.12);border-color:rgba(78,216,255,.20)}

    .card{position:relative;background:linear-gradient(180deg, rgba(255,255,255,.055), rgba(255,255,255,.025));border:1px solid rgba(255,255,255,.08);border-radius:24px;box-shadow:var(--shadow);overflow:hidden;transition: transform .28s ease, box-shadow .28s ease, border-color .28s ease, background .28s ease}
    .card::before{content:"";position:absolute;inset:0;background:linear-gradient(140deg, rgba(78,216,255,.08), transparent 28%, transparent 68%, rgba(255,92,184,.08)),radial-gradient(circle at 100% 100%, rgba(255,201,92,.08), transparent 22%);pointer-events:none}
    .card:hover{transform:translateY(-4px);border-color:rgba(255,255,255,.16);box-shadow:0 20px 50px rgba(0,0,0,.42),0 0 28px rgba(78,216,255,.08),0 0 44px rgba(168,92,255,.08)}
    .card-inner{position:relative;padding:24px;z-index:1}
    .tag{display:inline-flex;align-items:center;gap:8px;padding:8px 12px;border-radius:999px;background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.08);color:#e4edff;font-size:11px;font-weight:800;letter-spacing:.14em;text-transform:uppercase;margin-bottom:14px}
    .title-row{display:flex;align-items:center;gap:12px;margin-bottom:10px}
    .card h3{margin:0;font-size:28px;letter-spacing:-.03em}
    .card p{margin:0;color:var(--muted);line-height:1.75;font-size:15px}

    .icon-badge{width:48px;height:48px;border-radius:14px;display:grid;place-items:center;background:linear-gradient(135deg, rgba(78,216,255,.14), rgba(168,92,255,.10));border:1px solid rgba(255,255,255,.08);box-shadow:inset 0 1px 0 rgba(255,255,255,.06),0 0 18px rgba(78,216,255,.12);color:#dff3ff;flex-shrink:0}
    .icon-badge svg{width:24px;height:24px;display:block;stroke:url(#axGradient);stroke-width:1.9;fill:none;filter:drop-shadow(0 0 4px rgba(78,216,255,.65)) drop-shadow(0 0 8px rgba(168,92,255,.35))}

    .dashboard-grid{display:grid;gap:22px;grid-template-columns:1fr}
    .presale-layout{display:grid;grid-template-columns:1.1fr .9fr;gap:18px;align-items:start}
    .presale-main-stack,.app-side-stack,.subcards,.feature-list,.wallet-tiles,.buy-inputs,.presale-box,.summary-list,.chart-legend,.social-links{display:grid;gap:12px;margin-top:18px}
    .mini-card,.feature,.token-tile,.presale-row,.legend-item,.trust-line,.quick-link{padding:16px 18px;border-radius:18px;background:rgba(255,255,255,.035);border:1px solid rgba(255,255,255,.08)}
    .mini-card strong,.feature strong,.trust-line strong{display:block;font-size:16px;margin-bottom:7px}
    .mini-card p,.feature p,.trust-line p{margin:0;font-size:14px;line-height:1.68;color:var(--muted)}

    .wallet-lite-gold{background:linear-gradient(180deg, rgba(255,201,92,.18), rgba(255,140,0,.12)),linear-gradient(180deg, rgba(255,255,255,.05), rgba(255,255,255,.02));border:1px solid rgba(255,201,92,.35);box-shadow:0 0 0 1px rgba(255,201,92,.08),0 0 28px rgba(255,201,92,.25),0 0 60px rgba(255,140,0,.18),0 18px 60px rgba(0,0,0,.42)}
    .wallet-lite-gold .tag{background:rgba(255,201,92,.15);border-color:rgba(255,201,92,.35);color:#fff3c4}
    .wallet-lite-gold h3{color:#ffe6a3}
    .wallet-lite-gold p{color:#f5e6c8}
    .wallet-lite-gold .feature,.wallet-lite-gold .token-tile{background:rgba(255,201,92,.08);border:1px solid rgba(255,201,92,.25)}

    .token-line{display:flex;align-items:center;gap:12px}
    .token-icon{width:28px;height:28px;border-radius:50%;object-fit:cover;border:1px solid rgba(255,255,255,.12);background:#0b1224;flex-shrink:0}
    .token-line .meta{flex:1;min-width:0}
    .token-line .meta strong{display:block;font-size:15px}
    .token-line .meta span{display:block;font-size:13px;color:var(--muted)}
    .balance-value{font-size:15px;font-weight:800;color:#fff;text-align:right;white-space:nowrap}

    .wallet-identity-bar{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:14px 16px;border-radius:18px;background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.08);margin-top:18px}
    .wallet-badge{display:inline-flex;align-items:center;gap:10px;padding:10px 12px;border-radius:999px;background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.08);font-size:13px;font-weight:800;color:#dff7ff}
    .live-count{display:inline-flex;align-items:center;justify-content:center;min-width:34px;height:34px;padding:0 12px;border-radius:999px;background:linear-gradient(90deg,var(--cyan),var(--purple),var(--pink));color:#07101f;font-weight:900}
    .inline-actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:14px}
    .buy-field{display:grid;gap:8px}
    .buy-field label{font-size:13px;font-weight:700;color:#d6e4ff}
    .buy-field input{width:100%;border:none;outline:none;border-radius:14px;padding:14px 16px;background:rgba(255,255,255,.045);border:1px solid rgba(255,255,255,.08);color:#fff;font:inherit}
    .buy-preview{padding:14px 16px;border-radius:16px;background:rgba(255,255,255,.035);border:1px solid rgba(255,255,255,.08);color:#dce7ff;font-size:14px}

    .presale-row{display:flex;justify-content:space-between;gap:14px;color:#dce7ff;font-size:14px}
    .presale-progress{margin-top:18px;padding:16px 18px;border-radius:18px;background:rgba(255,255,255,.035);border:1px solid rgba(255,255,255,.08)}
    .progress-top{display:flex;align-items:center;justify-content:space-between;gap:14px;margin-bottom:10px}
    .progress-bar{height:12px;border-radius:999px;background:rgba(255,255,255,.06);overflow:hidden;border:1px solid rgba(255,255,255,.08)}
    .progress-fill{height:100%;width:0;background:linear-gradient(90deg, var(--cyan), var(--blue), var(--purple), var(--pink));box-shadow:0 0 20px rgba(95,140,255,.25)}
    .progress-note{margin-top:10px;color:#bdd0f7;font-size:13px;line-height:1.7}

    .summary-item{display:grid;grid-template-columns:auto 1fr;gap:14px;align-items:start;padding:16px 18px;border-radius:18px;background:rgba(255,255,255,.035);border:1px solid rgba(255,255,255,.08)}
    .contract-box{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:14px 16px;border-radius:16px;background:rgba(255,255,255,.035);border:1px solid rgba(255,255,255,.08);font-size:13px;color:#dce7ff;word-break:break-all}
    .icon-copy-btn{width:36px;height:36px;border:none;border-radius:12px;cursor:pointer;display:grid;place-items:center;color:#fff;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.08)}

    .social-link,.quick-link{display:flex;align-items:center;justify-content:space-between;gap:12px;color:#dce7ff;font-size:14px;font-weight:700}
    .social-link span:last-child,.quick-link span:last-child{color:#9ed7ff;font-size:13px;font-weight:800}

    .tokenomics-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px;margin-top:18px}
    .tokenomics-chart-wrap{position:relative;width:100%;max-width:430px;margin:auto;padding:8px}
    .tokenomics-chart-wrap::before{content:"";position:absolute;inset:5% 10%;background:radial-gradient(circle at center, rgba(255,102,76,.22), rgba(255,0,150,.14), rgba(0,200,255,.10), transparent 72%);filter:blur(40px);z-index:0;pointer-events:none}
    #tokenChart{position:relative;z-index:1;filter:drop-shadow(0 20px 40px rgba(0,0,0,.55))}
    .legend-item{display:flex;align-items:center;justify-content:space-between;gap:16px;color:#dce7ff;font-size:14px}
    .legend-left{display:flex;align-items:center;gap:10px}
    .swatch{width:12px;height:12px;border-radius:50%;flex-shrink:0}

    .success-card{display:none;margin-top:16px;padding:16px 18px;border-radius:18px;background:var(--success-bg);border:1px solid var(--success-border);color:var(--success-text);box-shadow:0 0 24px rgba(67,243,177,.08)}
    .success-card.show{display:block}
    .success-card strong{display:block;margin-bottom:8px;font-size:16px;color:#fff}
    .success-card p{color:#d8fff0;font-size:14px;line-height:1.7}

    .reveal{opacity:0;transform:translateY(26px);transition:opacity .7s ease, transform .7s ease}
    .reveal.show{opacity:1;transform:translateY(0)}

    .footer{padding:34px 0 54px;border-top:1px solid rgba(255,255,255,.06);margin-top:90px}
    .footer-row{display:flex;align-items:center;justify-content:space-between;gap:18px;flex-wrap:wrap}
    .footer-links{display:flex;gap:18px;flex-wrap:wrap;color:#c7d5f2;font-size:14px;font-weight:700}

    .ai-grid-overlay,.ai-data-stream,.ai-dashboard-hud,.ai-corner-brackets{position:fixed;inset:0;pointer-events:none;z-index:-1;overflow:hidden}
    .ai-grid-overlay{opacity:.5}
    .ai-grid-overlay::before{content:"";position:absolute;inset:-10%;background:linear-gradient(rgba(78,216,255,.075) 1px, transparent 1px),linear-gradient(90deg, rgba(95,140,255,.06) 1px, transparent 1px);background-size:72px 72px, 72px 72px;mask-image:radial-gradient(circle at center, rgba(0,0,0,.92), transparent 85%);-webkit-mask-image:radial-gradient(circle at center, rgba(0,0,0,.92), transparent 85%);animation:aiGridDrift 26s linear infinite}
    .ai-grid-overlay::after{content:"";position:absolute;width:60vw;height:60vw;left:50%;top:42%;transform:translate(-50%, -50%);border-radius:50%;background:radial-gradient(circle, rgba(78,216,255,.16) 0%, rgba(95,140,255,.12) 24%, rgba(168,92,255,.10) 44%, rgba(255,92,184,.07) 60%, transparent 74%);filter:blur(26px) saturate(112%);animation:aiPulseGlow 5.5s ease-in-out infinite}
    .ai-data-stream{opacity:.5}
    .ai-data-stream span{position:absolute;display:block;width:180px;height:2px;border-radius:999px;background:linear-gradient(90deg,transparent,rgba(78,216,255,0),rgba(78,216,255,.82),rgba(95,140,255,.68),rgba(168,92,255,.56),rgba(255,92,184,.42),transparent);box-shadow:0 0 16px rgba(78,216,255,.20),0 0 28px rgba(168,92,255,.10);animation:aiStreamMove linear infinite}
    .ai-data-stream span:nth-child(1){top:12%;left:-22%;animation-duration:14s;animation-delay:-2s}
    .ai-data-stream span:nth-child(2){top:26%;left:-28%;width:240px;animation-duration:18s;animation-delay:-7s}
    .ai-data-stream span:nth-child(3){top:39%;left:-18%;width:160px;animation-duration:12s;animation-delay:-4s}
    .ai-data-stream span:nth-child(4){top:58%;left:-26%;width:220px;animation-duration:20s;animation-delay:-10s}
    .ai-data-stream span:nth-child(5){top:72%;left:-20%;width:190px;animation-duration:16s;animation-delay:-6s}
    .ai-data-stream span:nth-child(6){top:84%;left:-30%;width:260px;animation-duration:22s;animation-delay:-11s}
